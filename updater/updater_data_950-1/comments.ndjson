func=jag::game::HitmarkType::DecodeType	func_addr=0x006b6660	kind=pre	insn_offset_from_entry=0	cu_index_from_entry=0	text=jag::game::HitmarkType::DecodeType (config group 29). op1/2\egSmart2or4 damageSprite/2; op3\estring; op4/5\eg3 medium colour/colour2; op6\eg1; op7\eg1 flags; op8\eg1 bool; op9/20\eg2(-1) varbit + g2(-1) varp + g4 + g4; op10-14\estring; op15\epolygon(g1 n,n*2 g2s,g4,g1 m,m*g4,n*g1); op17\estring; op18\egSmart2or4; op19\eg2; op21/22\eg4 byteswap; op23\e3*g1; op24\e2*g2s<<9; op25\egSmart2or4; op26/27\eg2(-1) varbit + g2(-1) varp + [op27 g2(-1)] + g1 n + (n+1)*g2; op28-30\eg1; op249\eparams. Server decoder previously mirrored HeadbarType for op2-20 (wrong).
